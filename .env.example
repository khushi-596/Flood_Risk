# ─── Backend (FastAPI) ─────────────────────────────────────────────────────────
APP_ENV=development

# PostgreSQL — on Render, set via fromDatabase binding in render.yaml
DATABASE_URL=postgresql+psycopg://flood:flood@db:5432/flood_risk

# Redis — optional; app degrades gracefully without it
REDIS_URL=redis://redis:6379/0

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Paths (Docker defaults; override for local dev)
DATA_DIR=/workspace/data
MODEL_CONFIG=/workspace/models/risk_engine/v1/risk_weights.yaml
UPLOAD_DIR=/workspace/uploads

# Auth — CHANGE THESE before deploying
JWT_SECRET=replace-with-a-long-random-value-before-deployment
JWT_ALGORITHM=HS256
MUNICIPAL_DEMO_EMAIL=staff@pune.gov.in
MUNICIPAL_DEMO_PASSWORD=change-before-deployment

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# Point to your deployed API URL in production
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
